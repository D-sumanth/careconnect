@page
@model CareConnect.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Notice control centre";
}

<partial name="_AdminNav" />

<section class="hero-panel admin-hero mb-4">
    <p class="eyebrow mb-2">Admin console</p>
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
        <div>
            <h1 class="section-title mb-2">Notice control centre</h1>
            <p class="lead-copy mb-0">Create, publish, track, and export acknowledgement progress by notice.</p>
        </div>
        <a class="btn btn-primary touch-button" asp-page="/Admin/Notices">Create notice</a>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Active notices</div><div class="display-6 fw-bold">@Model.Summary.ActiveNotices</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Drafts</div><div class="display-6 fw-bold">@Model.Summary.DraftNotices</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Acknowledgements</div><div class="display-6 fw-bold">@Model.Summary.Acknowledgements</div></div></div>
    <div class="col-md-3"><div class="stat-card"><div class="stat-label">Outstanding</div><div class="display-6 fw-bold">@Model.Summary.Outstanding</div></div></div>
</div>

<partial name="_NoticeProgressTable" model="Model.Notices" />
