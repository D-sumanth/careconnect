@page
@model CareConnect.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<partial name="_AdminNav" />

<div class="row g-4">
    <div class="col-lg-5">
        <section class="content-panel">
            <h1 class="section-title">Create user</h1>
            <form method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="mb-3"><label asp-for="Input.DisplayName" class="form-label"></label><input asp-for="Input.DisplayName" class="form-control" /><span asp-validation-for="Input.DisplayName"></span></div>
                <div class="mb-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" /><span asp-validation-for="Input.Email"></span></div>
                <div class="mb-3"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" class="form-control" /><span asp-validation-for="Input.Password"></span></div>
                <div class="mb-3"><label asp-for="Input.Role" class="form-label"></label><select asp-for="Input.Role" asp-items="Model.RoleOptions" class="form-select"></select></div>
                <div class="mb-3"><label asp-for="Input.DepartmentId" class="form-label"></label><select asp-for="Input.DepartmentId" asp-items="Model.DepartmentOptions" class="form-select"><option value="">No department</option></select></div>
                <div class="form-check mb-4"><input asp-for="Input.IsDepartmentLead" class="form-check-input" /><label asp-for="Input.IsDepartmentLead" class="form-check-label"></label></div>
                <button class="btn btn-primary touch-button" type="submit">Create user</button>
            </form>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="content-panel">
            <h2 class="section-title">Users</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Name</th><th>Email</th><th>Active</th><th>Last login</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td><span class="status-pill @(user.IsActive ? string.Empty : "status-pill-muted")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                                <td>@(user.LastLoginAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@user.Id">
                                            <button class="btn btn-outline-danger btn-sm" type="submit">Deactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Reactivate" asp-route-id="@user.Id">
                                            <button class="btn btn-outline-primary btn-sm" type="submit">Reactivate</button>
                                        </form>
                                    }
                                    <details class="mt-2">
                                        <summary class="btn btn-outline-primary btn-sm">Reset password</summary>
                                        <form method="post" asp-page-handler="ResetPassword" asp-route-id="@user.Id" class="mt-2">
                                            <input name="temporaryPassword" class="form-control form-control-sm mb-2" placeholder="Temporary password" />
                                            <button class="btn btn-primary btn-sm" type="submit">Set password</button>
                                        </form>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
