@page
@model CareConnect.Web.Pages.Admin.AcknowledgementsModel
@{
    ViewData["Title"] = "Acknowledgements";
}

<partial name="_AdminNav" />

<section class="content-panel mb-4">
    <h1 class="section-title">Acknowledgement records</h1>
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-select"><option value="">All departments</option></select></div>
        <div class="col-md-3"><label asp-for="InformationUpdateId" class="form-label"></label><select asp-for="InformationUpdateId" asp-items="Model.NoticeOptions" class="form-select"><option value="">All notices</option></select></div>
        <div class="col-md-2"><label asp-for="From" class="form-label"></label><input asp-for="From" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="To" class="form-label"></label><input asp-for="To" class="form-control" /></div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Filter</button></div>
    </form>
    <form method="post" asp-page-handler="Export" class="mt-3">
        <input type="hidden" asp-for="DepartmentId" />
        <input type="hidden" asp-for="InformationUpdateId" />
        <input type="hidden" asp-for="From" />
        <input type="hidden" asp-for="To" />
        <button class="btn btn-outline-primary" type="submit">Export CSV</button>
    </form>
</section>

<section class="content-panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Notice</th><th>Department</th><th>Staff member</th><th>Signature</th><th>Lead</th><th>When</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.NoticeTitle</td>
                        <td>@row.DepartmentName</td>
                        <td>@row.StaffMemberName</td>
                        <td>@row.SignatureText</td>
                        <td>@row.LeadUserId</td>
                        <td>@row.AcknowledgedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
