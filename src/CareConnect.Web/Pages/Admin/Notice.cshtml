@page "{id:guid}"
@model CareConnect.Web.Pages.Admin.NoticeModel
@{
    ViewData["Title"] = Model.Notice?.Title ?? "Notice";
}

<partial name="_AdminNav" />

@if (Model.Notice is null)
{
    <section class="content-panel">
        <h1 class="section-title">Notice not found</h1>
        <p class="lead-copy mb-0">The requested notice is unavailable.</p>
    </section>
}
else
{
    <a asp-page="/Admin/Notices" class="btn btn-link px-0 mb-3">Back to notices</a>
    <section class="content-panel mb-4">
        <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
            <div>
                <p class="eyebrow mb-2">@Model.Notice.Type notice</p>
                <h1 class="section-title mb-2">@Model.Notice.Title</h1>
                <p class="lead-copy mb-0">@Model.Notice.Summary</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.Notice.Status == "Draft")
                {
                    <form method="post" asp-page-handler="Publish"><button class="btn btn-success" type="submit">Publish</button></form>
                }
                @if (Model.Notice.Status != "Archived")
                {
                    <form method="post" asp-page-handler="Archive"><button class="btn btn-outline-danger" type="submit">Archive</button></form>
                }
                <form method="post" asp-page-handler="Export"><button class="btn btn-outline-primary" type="submit">Export CSV</button></form>
            </div>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="stat-card"><div class="text-muted">Status</div><div class="h3 fw-bold">@Model.Notice.Status</div></div></div>
        <div class="col-md-3"><div class="stat-card"><div class="text-muted">Expected</div><div class="h3 fw-bold">@Model.Progress.ExpectedCount</div></div></div>
        <div class="col-md-3"><div class="stat-card"><div class="text-muted">Acknowledged</div><div class="h3 fw-bold">@Model.Progress.AcknowledgedCount</div></div></div>
        <div class="col-md-3"><div class="stat-card"><div class="text-muted">Outstanding</div><div class="h3 fw-bold">@Model.Progress.OutstandingCount</div></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <section class="content-panel">
                <h2 class="section-title">Edit notice</h2>
                <form method="post" asp-page-handler="Save">
                    <div asp-validation-summary="ModelOnly"></div>
                    <div class="mb-3"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title"></span></div>
                    <div class="mb-3"><label asp-for="Input.Summary" class="form-label"></label><textarea asp-for="Input.Summary" class="form-control" rows="2"></textarea><span asp-validation-for="Input.Summary"></span></div>
                    <div class="mb-3"><label asp-for="Input.Body" class="form-label"></label><textarea asp-for="Input.Body" class="form-control" rows="7"></textarea><span asp-validation-for="Input.Body"></span></div>
                    <div class="mb-3"><label asp-for="Input.AuthorizedBy" class="form-label"></label><input asp-for="Input.AuthorizedBy" class="form-control" /><span asp-validation-for="Input.AuthorizedBy"></span></div>
                    <div class="mb-3"><label asp-for="Input.Type" class="form-label"></label><select asp-for="Input.Type" asp-items="Model.TypeOptions" class="form-select"></select></div>
                    <div class="row g-3">
                        <div class="col-md-6 mb-3"><label asp-for="Input.ReviewBy" class="form-label"></label><input asp-for="Input.ReviewBy" type="date" class="form-control" /></div>
                        <div class="col-md-6 mb-3"><label asp-for="Input.ExpiresOn" class="form-label"></label><input asp-for="Input.ExpiresOn" type="date" class="form-control" /></div>
                    </div>
                    <div class="mb-4"><label asp-for="Input.DepartmentIds" class="form-label"></label><select asp-for="Input.DepartmentIds" asp-items="Model.DepartmentOptions" class="form-select" multiple size="5"></select><span asp-validation-for="Input.DepartmentIds"></span></div>
                    <button class="btn btn-primary touch-button" type="submit">Save changes</button>
                </form>
            </section>
        </div>
        <div class="col-lg-7">
            <section class="content-panel mb-4">
                <h2 class="section-title">Department progress</h2>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Department</th><th>Expected</th><th>Acknowledged</th><th>Missing</th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.DepartmentProgress)
                            {
                                <tr><td>@row.DepartmentName</td><td>@row.ExpectedCount</td><td>@row.AcknowledgedCount</td><td>@row.MissingCount</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="content-panel">
                <h2 class="section-title">Acknowledgements</h2>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Staff member</th><th>Department</th><th>Signature</th><th>When</th><th>Status</th><th>Admin action</th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.Acknowledgements)
                            {
                                <tr>
                                    <td>@row.StaffMemberName</td>
                                    <td>@row.DepartmentName</td>
                                    <td>@row.SignatureText</td>
                                    <td>@row.AcknowledgedAt.ToLocalTime().ToString("g")</td>
                                    <td>
                                        <span class="status-pill @(row.IsVoided ? "status-pill-muted" : string.Empty)">@(row.IsVoided ? "Voided" : "Active")</span>
                                        @if (!string.IsNullOrWhiteSpace(row.CorrectionNote))
                                        {
                                            <div class="text-muted small">@row.CorrectionNote</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.VoidReason))
                                        {
                                            <div class="text-muted small">@row.VoidReason</div>
                                        }
                                    </td>
                                    <td>
                                        @if (!row.IsVoided)
                                        {
                                            <details>
                                                <summary class="btn btn-outline-primary btn-sm">Correct</summary>
                                                <form method="post" asp-page-handler="CorrectAcknowledgement" asp-route-acknowledgementId="@row.Id" class="mt-2">
                                                    <input name="staffMemberName" value="@row.StaffMemberName" class="form-control form-control-sm mb-2" />
                                                    <input name="note" placeholder="Correction note" class="form-control form-control-sm mb-2" />
                                                    <button class="btn btn-primary btn-sm" type="submit">Save correction</button>
                                                </form>
                                            </details>
                                            <form method="post" asp-page-handler="VoidAcknowledgement" asp-route-acknowledgementId="@row.Id" class="mt-2">
                                                <input name="reason" placeholder="Void reason" class="form-control form-control-sm mb-2" />
                                                <button class="btn btn-outline-danger btn-sm" type="submit">Void</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="content-panel mt-4">
                <h2 class="section-title">Missing acknowledgements</h2>
                @if (Model.MissingStaff.Count == 0)
                {
                    <p class="text-muted mb-0">No named staff are currently missing for this notice.</p>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var missing in Model.MissingStaff)
                        {
                            <div class="col-md-6">
                                <div class="missing-staff-chip">
                                    <strong>@missing.FullName</strong>
                                    <span>@missing.DepartmentName</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
