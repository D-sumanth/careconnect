@{
    var path = Context.Request.Path.Value ?? string.Empty;
    string Active(string page) => path.StartsWith(page, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<nav class="admin-nav" aria-label="Admin navigation">
    <a class="@Active("/Admin/Notice")" asp-page="/Admin/Notices">Notices</a>
    <a class="@Active("/Admin/Acknowledgements")" asp-page="/Admin/Acknowledgements">Acknowledgements</a>
    <a class="@Active("/Admin/Departments")" asp-page="/Admin/Departments">Departments</a>
    <a class="@Active("/Admin/Users")" asp-page="/Admin/Users">Users</a>
    <a class="@Active("/Admin/AuditLog")" asp-page="/Admin/AuditLog">Audit log</a>
</nav>
