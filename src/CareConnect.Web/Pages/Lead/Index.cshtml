@page
@model CareConnect.Web.Pages.Lead.IndexModel
@{
    ViewData["Title"] = "Lead dashboard";
}

<section class="content-panel mb-4">
    <p class="eyebrow mb-2">Department lead</p>
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
        <div>
            <h1 class="section-title mb-2">Assigned notices</h1>
            <p class="lead-copy mb-0">Open each notice with your team and capture typed acknowledgements on this device.</p>
        </div>
        <span class="badge text-bg-light border">@Model.Notices.Count notices</span>
    </div>
</section>

@if (Model.Notices.Count == 0)
{
    <section class="content-panel">
        <h2 class="section-title">No notices assigned</h2>
        <p class="lead-copy mb-0">There are no published notices for your departments right now.</p>
    </section>
}
else
{
    <div class="row g-3">
        @foreach (var notice in Model.Notices)
        {
            <div class="col-md-6 col-xl-4">
                <article class="notice-card">
                    <div class="d-flex justify-content-between gap-2 mb-3">
                        <span class="badge @notice.BadgeClass">@notice.Type</span>
                        <span class="text-muted small">@notice.PublishedAt?.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </div>
                    <h2 class="h5">@notice.Title</h2>
                    <p class="text-muted">@notice.Summary</p>
                    <p class="small mb-3"><strong>Departments:</strong> @notice.DepartmentNames</p>
                    <a class="btn btn-primary touch-button w-100" asp-page="/Lead/Notice" asp-route-id="@notice.Id">Open notice</a>
                </article>
            </div>
        }
    </div>
}
